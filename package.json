{
    "name": "ephesians-fitness",
    "version": "1.0.0",
    "private": true,
    "scripts": {
        "start": "ng serve --host 127.0.0.1 --proxy-config proxy.conf.json",
        "build": "ng build",
        "watch": "ng build --watch --configuration development",
        "check": "tsc --noEmit -p tsconfig.app.json",
        "server": "node --env-file-if-exists=server/.env server/server.cjs",
        "test:checkout": "node --test server/order-service.test.cjs"
    },
    "dependencies": {
        "@angular/common": "21.2.25",
        "@angular/compiler": "21.2.25",
        "@angular/core": "21.2.25",
        "@angular/forms": "21.2.25",
        "@angular/platform-browser": "21.2.25",
        "@angular/router": "21.2.25",
        "@primeuix/themes": "^2.0.3",
        "nodemailer": "^10.0.15",
        "primeicons": "^7.0.0",
        "primeng": "21.1.3",
        "rxjs": "~7.8.2",
        "tslib": "^2.8.1"
    },
    "devDependencies": {
        "@angular/build": "21.2.25",
        "@angular/cli": "21.2.25",
        "@angular/compiler-cli": "21.2.25",
        "@playwright/test": "^1.56.0",
        "typescript": "~5.9.3"
    }
}
