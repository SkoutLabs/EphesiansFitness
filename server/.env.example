# Preview writes emails locally and never contacts Gmail/SMTP.
MAIL_MODE=preview
PORT=3000
HOST=127.0.0.1
ORDER_DATA_DIR=./server/data
MAIL_FROM=fitnessephesians@gmail.com
BUSINESS_EMAIL=fitnessephesians@gmail.com
# Set these to verified business bank details before enabling live checkout.
BANK_ACCOUNT_NAME=
BANK_NAME=
BANK_ACCOUNT_NUMBER=
BANK_BRANCH_CODE=
# Gmail OAuth2, matching the original server. Do not commit credentials.
GOOGLE_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# Alternatively use an SMTP account.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
